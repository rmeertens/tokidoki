// Firestore security rules for the optional login (sync.js): each user can
// read and write only their own document, users/{uid}. Paste these into the
// Firebase console under Firestore Database → Rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
